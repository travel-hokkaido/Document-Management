<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>TRAVEL HOKKAIDO Invoice</title>
<style>
  :root { --hd:#2c3e6b; --ac:#3a5ba0; --lb:#e8ecf3; --tl:#f0e6c8; --bd:#b0b0b0; }
  *{box-sizing:border-box;margin:0;padding:0}
  body{font-family:"Segoe UI","Meiryo","Hiragino Sans","Yu Gothic","Apple SD Gothic Neo",sans-serif;background:#f4f5f7;color:#222;padding:20px;padding-bottom:70px}
  .toolbar{display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:8px;margin-bottom:0}
  .tab-bar{display:flex;gap:4px}
  .tab-btn{padding:10px 24px;border:1px solid var(--bd);border-bottom:none;border-radius:6px 6px 0 0;background:#d0d5df;color:#444;font-size:13px;font-weight:600;cursor:pointer;transition:background .2s}
  .tab-btn.active{background:var(--hd);color:#fff}
  .dl-btns{display:flex;gap:8px}
  .dl-btn{padding:8px 18px;border:none;border-radius:6px;background:var(--ac);color:#fff;font-size:13px;font-weight:600;cursor:pointer;transition:background .15s,transform .1s}
  .dl-btn:hover{background:#2a4a8a} .dl-btn:active{transform:scale(.97)}
  .dl-btn.share-btn{background:#27ae60} .dl-btn.share-btn:hover{background:#219a52}
  .dl-btn.reset-btn{background:#e67e22} .dl-btn.reset-btn:hover{background:#d35400}
  .dl-btn.pdf-btn{background:#c0392b} .dl-btn.pdf-btn:hover{background:#a93226}
  .dl-btn.calc-btn{background:#8e44ad} .dl-btn.calc-btn:hover{background:#7d3c98}
  .sheet{display:none;background:#fff;border:1px solid var(--bd);border-radius:0 8px 8px 8px;overflow:hidden;box-shadow:0 2px 12px rgba(0,0,0,.08)}
  .sheet.active{display:block}
  table{width:100%;border-collapse:collapse;table-layout:fixed}
  td{border:1px solid #ccc;padding:6px 10px;font-size:13px;vertical-align:top;line-height:1.5;outline:none}
  [contenteditable]{cursor:text;-webkit-user-select:text;user-select:text}
  [contenteditable]:focus{background:#fffde7;box-shadow:inset 0 0 0 2px var(--ac)}
  .hd td{background:var(--hd);color:#fff;font-weight:700;font-size:18px;text-align:center;border-color:#1e2d50;letter-spacing:3px}
  .sh td{background:var(--ac);color:#fff;font-weight:600;font-size:13px;border-color:#2a4a8a}
  .cr td{background:#f7f8fa;font-size:12px;color:#444}
  .lb{background:var(--lb)!important;font-weight:600;color:#333}
  .tr td{background:var(--tl);font-weight:700;font-size:14px}
  .am{text-align:right;font-family:"Consolas","Menlo",monospace}
  .sp td{border:none;background:#f7f8fa;height:10px;padding:0}
  .at{background:#e8f5e9!important;transition:background .3s}
  .at.fl{background:#a5d6a7!important}
  .ca{width:36px} .c1{width:16%} .c2{width:auto} .c3{width:14%} .c4{width:14%}
  .ra{text-align:center;padding:2px!important;vertical-align:middle;background:#f9f9f9!important}
  .bd{width:22px;height:22px;border:none;border-radius:4px;background:#e74c3c;color:#fff;font-size:13px;font-weight:700;cursor:pointer;line-height:22px;padding:0;opacity:.5;transition:opacity .15s}
  .bd:hover{opacity:1}
  .ba{display:flex;align-items:center;justify-content:center;gap:4px;width:100%;padding:5px 0;border:2px dashed #bbb;border-radius:4px;background:#fafafa;color:#888;font-size:12px;font-weight:600;cursor:pointer;transition:all .15s;margin:4px 0}
  .ba:hover{border-color:var(--ac);color:var(--ac);background:#eef2fa}
  .note{padding:12px 16px;font-size:12px;color:#777;background:#f9f9f9;border-top:1px solid #eee;text-align:center}
  .logo-zone{text-align:center;padding:16px 10px 8px;border:none;background:#fff}
  .logo-drop{display:inline-flex;align-items:center;justify-content:center;gap:6px;padding:14px 32px;border:2px dashed #bbb;border-radius:8px;background:#fafafa;color:#888;font-size:13px;font-weight:600;cursor:pointer;transition:all .15s;min-height:60px}
  .logo-drop:hover{border-color:var(--ac);color:var(--ac);background:#eef2fa}
  .logo-drop.over{border-color:var(--ac);background:#e0e8f5}
  .logo-preview{display:none;text-align:center;padding:0}
  .logo-preview img{max-height:80px;max-width:280px;object-fit:contain}
  .logo-remove{display:inline-block;margin-left:10px;padding:3px 10px;border:none;border-radius:4px;background:#e74c3c;color:#fff;font-size:11px;font-weight:600;cursor:pointer;vertical-align:middle;opacity:.6;transition:opacity .15s}
  .logo-remove:hover{opacity:1}
  .csv-modal{display:none;position:fixed;top:0;left:0;right:0;bottom:0;background:rgba(0,0,0,.5);z-index:100;align-items:center;justify-content:center}
  .csv-modal.show{display:flex}
  .csv-box{background:#fff;border-radius:12px;padding:20px;width:90%;max-width:600px;max-height:80vh;display:flex;flex-direction:column;gap:12px}
  .csv-box h3{margin:0;font-size:15px;color:#333}
  .csv-box textarea{width:100%;height:300px;font-size:12px;font-family:monospace;border:1px solid #ccc;border-radius:6px;padding:10px;resize:vertical}
  .csv-box .csv-btns{display:flex;gap:8px;justify-content:flex-end}
  .csv-box button{padding:8px 18px;border:none;border-radius:6px;font-size:13px;font-weight:600;cursor:pointer}
  .csv-box .copy-btn{background:#0f9d58;color:#fff}
  .csv-box .close-btn{background:#e0e0e0;color:#333}
  .toast{position:fixed;bottom:70px;left:50%;transform:translateX(-50%);background:#222;color:#fff;padding:10px 24px;border-radius:8px;font-size:13px;opacity:0;transition:opacity .3s;pointer-events:none;z-index:99}
  .toast.show{opacity:1}
  .dl-btn.save-inv{background:#2980b9} .dl-btn.save-inv:hover{background:#2471a3}
  .dl-btn.load-inv{background:#27ae60} .dl-btn.load-inv:hover{background:#219a52}
  .inv-modal{display:none;position:fixed;top:0;left:0;right:0;bottom:0;background:rgba(0,0,0,.5);z-index:100;align-items:center;justify-content:center}
  .inv-modal.show{display:flex}
  .inv-box{background:#fff;border-radius:12px;padding:20px;width:90%;max-width:500px;max-height:80vh;display:flex;flex-direction:column;gap:12px}
  .inv-box h3{margin:0;font-size:15px;color:#333}
  .inv-list{overflow-y:auto;max-height:50vh;display:flex;flex-direction:column;gap:6px}
  .inv-item{display:flex;align-items:center;justify-content:space-between;padding:10px 14px;border:1px solid #ddd;border-radius:8px;cursor:pointer;transition:background .15s}
  .inv-item:hover{background:#eef2fa}
  .inv-item-name{font-weight:600;font-size:14px;color:#333}
  .inv-item-date{font-size:11px;color:#888}
  .inv-item-del{border:none;background:#e74c3c;color:#fff;border-radius:4px;padding:4px 10px;font-size:11px;cursor:pointer;opacity:.6}
  .inv-item-del:hover{opacity:1}
  .inv-empty{text-align:center;color:#aaa;padding:30px;font-size:13px}
  .inv-box .inv-btns{display:flex;gap:8px;justify-content:flex-end}
  .inv-box button.inv-close{padding:8px 18px;border:none;border-radius:6px;background:#e0e0e0;color:#333;font-size:13px;font-weight:600;cursor:pointer}
  @media print{
    body{background:#fff;padding:15px 20px;margin:0}
    .toolbar,.note,.ba,.logo-drop,.logo-remove,.csv-modal,.bd,.ra{display:none!important}
    col.ca{display:none}
    .logo-preview{display:block!important}
    #s-ko,#s-jp,#s-en{display:none!important}
    #s-ko.active,#s-jp.active,#s-en.active{display:block!important;border:none;box-shadow:none;border-radius:0}
    td{font-size:12px;padding:5px 8px;word-break:keep-all}
    td.lb{white-space:nowrap}
    table{table-layout:auto!important;width:100%!important;margin:0;page-break-inside:auto}
    .sheet{overflow:visible!important}
  }
</style>
</head>
<body>

<div class="toolbar">
  <div class="tab-bar">
    <button class="tab-btn active" onclick="sw('ko')">한국어</button>
    <button class="tab-btn" onclick="sw('jp')">日本語</button>
    <button class="tab-btn" onclick="sw('en')">English</button>
  </div>
  <div class="dl-btns">
    <button class="dl-btn save-inv" onclick="saveInvoiceAs()">📁 Save</button>
    <button class="dl-btn load-inv" onclick="openLoadModal()">📂 Load</button>
    <button class="dl-btn reset-btn" onclick="resetInvoice()">Reset</button>
    <button class="dl-btn calc-btn" onclick="calcAll()">Calculate</button>
    <button class="dl-btn pdf-btn" onclick="printPDF()">Save PDF</button>
  </div>
</div>

