    </div>
  </div>
</div>
<input type="file" id="logo-input" accept="image/*" style="display:none">

<script>
function sw(l){document.querySelectorAll('.sheet').forEach(s=>s.classList.remove('active'));document.querySelectorAll('.tab-btn').forEach(b=>b.classList.remove('active'));document.getElementById('s-'+l).classList.add('active');document.querySelectorAll('.tab-btn')[['ko','jp','en'].indexOf(l)].classList.add('active')}

var logoDataURL=null;
var logoInput=document.getElementById('logo-input');

function setLogo(dataURL){
  logoDataURL=dataURL;
  if(dataURL){try{localStorage.setItem('th_invoice_logo',dataURL)}catch(e){}}
  else{localStorage.removeItem('th_invoice_logo')}
  ['ko','jp','en'].forEach(function(lang){
    var drop=document.getElementById('logo-drop-'+lang);
    var preview=document.getElementById('logo-preview-'+lang);
    if(dataURL){
      drop.style.display='none';
      preview.style.display='block';
      preview.innerHTML='<img src="'+dataURL+'"><button class="logo-remove">✕ 삭제</button>';
    } else {
      drop.style.display='';
      preview.style.display='none';
      preview.innerHTML='';
    }
  });
}

function removeLogo(){setLogo(null)}

function handleLogoFile(file){
  if(!file||!file.type.startsWith('image/'))return;
  var reader=new FileReader();
  reader.onload=function(e){setLogo(e.target.result)};
  reader.readAsDataURL(file);
}

logoInput.addEventListener('change',function(){
  if(this.files&&this.files[0])handleLogoFile(this.files[0]);
  this.value='';
});

document.querySelectorAll('.logo-drop').forEach(function(zone){
  zone.addEventListener('dragover',function(e){e.preventDefault();this.classList.add('over')});
  zone.addEventListener('dragleave',function(){this.classList.remove('over')});
  zone.addEventListener('drop',function(e){
    e.preventDefault();this.classList.remove('over');
    if(e.dataTransfer.files&&e.dataTransfer.files[0])handleLogoFile(e.dataTransfer.files[0]);
  });
});

var savedLogo=localStorage.getItem('th_invoice_logo');
if(savedLogo)setLogo(savedLogo);

var saveTimer=null;
function scheduleSave(){
  if(saveTimer)clearTimeout(saveTimer);
  saveTimer=setTimeout(saveAll,500);
}
function saveAll(){
  ['ko','jp','en'].forEach(function(lang){
    var sh=document.getElementById('s-'+lang);
    if(!sh)return;
    var cells=[];
    sh.querySelectorAll('td[contenteditable="true"]').forEach(function(td){
      cells.push(td.innerHTML);
    });
    var svcCount=0,payCount=0;
    var svcTb=sh.querySelector('[data-g="svc"]');
    var payTb=sh.querySelector('[data-g="pay"]');
    if(svcTb)svcCount=svcTb.querySelectorAll('tr').length;
    if(payTb)payCount=payTb.querySelectorAll('tr').length;
    try{localStorage.setItem('th_inv2_'+lang,JSON.stringify({cells:cells,svc:svcCount,pay:payCount}))}catch(e){}
  });
}
function loadAll(){
  ['ko','jp','en'].forEach(function(lang){
    var raw=localStorage.getItem('th_inv2_'+lang);
    if(!raw)return;
    try{var data=JSON.parse(raw)}catch(e){return}
    var sh=document.getElementById('s-'+lang);
    if(!sh)return;
    var svcTb=sh.querySelector('[data-g="svc"]');
    var payTb=sh.querySelector('[data-g="pay"]');
    if(svcTb){for(var i=1;i<data.svc;i++){
      var tr=document.createElement('tr');
      tr.innerHTML='<td class="ra"><button class="bd">×</button></td><td contenteditable="true"></td><td contenteditable="true"></td><td contenteditable="true" class="am"></td><td contenteditable="true" class="am" data-a="svc"></td>';
      svcTb.appendChild(tr);
    }}
    if(payTb){for(var i=1;i<data.pay;i++){
      var tr=document.createElement('tr');
      tr.innerHTML='<td class="ra"><button class="bd">×</button></td><td contenteditable="true"></td><td contenteditable="true"></td><td contenteditable="true" class="am"></td><td contenteditable="true" class="am" data-a="pay"></td>';
      payTb.appendChild(tr);
    }}
    var cells=sh.querySelectorAll('td[contenteditable="true"]');
    for(var i=0;i<cells.length&&i<data.cells.length;i++){
      cells[i].innerHTML=data.cells[i];
    }
    sh.querySelectorAll('[data-a]').forEach(ba);
  });
}
if(!localStorage.getItem('th_inv_v6')){
  localStorage.removeItem('th_inv2_ko');
  localStorage.removeItem('th_inv2_jp');
  localStorage.removeItem('th_inv2_en');
  localStorage.setItem('th_inv_v6','1');
}
loadAll();

window.addEventListener('mousedown',function(){window.focus()},true);
document.designMode='on';
document.addEventListener('paste',function(e){
  e.preventDefault();
